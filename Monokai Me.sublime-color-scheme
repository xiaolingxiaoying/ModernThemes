            "foreground": "var(yellow)",
            "font_style": "bold"
        },
        {
            "name": "Markdown bold",
            "scope": "markup.bold",
            "foreground": "var(yellow)",
            "font_style": "bold"
        },
        {
            "name": "Markdown highlight",
            "scope": "markup.highlight",
            "background": "color(var(yellow) alpha(0.3))"
        },
        {
            "name": "Markdown raw code",
            "scope": "markup.raw",
            "foreground": "var(blue)"
        },
        {
            "name": "Markdown raw punctuation",
            "scope": "markup.raw punctuation.definition.raw",
            "foreground": "var(blue)"
        },
        {
            "name": "Markdown links and URLs",
            "scope": "markup.underline.link, markup.underline.link.image, string.other.link, meta.link.inline string, meta.link.reference string",
            "foreground": "var(blue)"
        },
        {
            "name": "Markdown list and quote markers",
