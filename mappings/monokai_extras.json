{
    "rules": [
        {
            "name": "Regular expressions",
            "scopes": "constant.regexp, string.regexp, constant.character.character-class.regexp, constant.other.character-class.set.regexp, constant.other.character-class.regexp, constant.character.set.regexp",
            "foreground": "var(red)"
        },
        {
            "name": "Keyword operators",
            "scopes": "keyword.operator",
            "foreground": "var(white3)"
        },
        {
            "name": "Keyword operator words",
            "scopes": "keyword.operator.new, keyword.operator.expression, keyword.operator.cast, keyword.operator.sizeof, keyword.operator.alignof, keyword.operator.typeid, keyword.operator.alignas, keyword.operator.instanceof, keyword.operator.logical.python, keyword.operator.wordlike",
            "foreground": "var(red2)"
        },
        {
            "name": "Markdown strikethrough",
            "scopes": "markup.strikethrough",
            "font_style": "stippled_underline"
        },
        {
            "name": "VS Code semantic token: newOperator",
            "scopes": "meta.semantic-token.newoperator",
            "foreground": "var(red2)"
        },
        {
            "name": "VS Code semantic token: stringLiteral",
            "scopes": "meta.semantic-token.stringliteral",
            "foreground": "var(yellow)"
        },
        {
            "name": "VS Code semantic token: customLiteral",
            "scopes": "meta.semantic-token.customliteral",
            "foreground": "var(yellow2)"
        },
        {
            "name": "VS Code semantic token: numberLiteral",
            "scopes": "meta.semantic-token.numberliteral",
            "foreground": "var(purple)"
        }
    ]
}
