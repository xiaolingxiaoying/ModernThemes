{
    "name": "VS Code Dark Modern Enhanced",
    "author": "Microsoft VS Code palette; generated Sublime Text adaptation",
    "globals": {
        "background": "#1F1F1F",
        "foreground": "#CCCCCC",
        "inactive_selection": "#3A3D41",
        "highlight": "#ADD6FF26",
        "find_highlight": "#9E6A03",
        "gutter_foreground": "#6E7681",
        "gutter_foreground_highlight": "#CCCCCC",
        "guide": "#404040",
        "active_guide": "#707070",
        "line_highlight": "#2A2D2E",
        "caret": "#AEAFAD",
        "brackets_options": "underline",
        "brackets_foreground": "#FFFFFF",
        "bracket_contents_options": "underline",
        "bracket_contents_foreground": "#FFFFFF",
        "selection": "#264F78",
        "selection_border": "#264F78"
    },
    "rules": [
        {
            "scope": "meta.embedded, source.groovy.embedded, string meta.image.inline.markdown, variable.legacy.builtin.python",
            "foreground": "#D4D4D4"
        },
        {
            "scope": "emphasis",
            "font_style": "italic"
        },
        {
            "scope": "strong",
            "font_style": "bold"
        },
        {
            "scope": "header",
            "foreground": "#000080"
        },
        {
            "scope": "comment",
            "foreground": "#6A9955"
        },
        {
            "scope": "constant.language",
            "foreground": "#569cd6"
        },
        {
            "scope": "constant.numeric, variable.other.enummember, constant.other.enum, constant.other.enummember, keyword.operator.plus.exponent, keyword.operator.minus.exponent",
            "foreground": "#b5cea8"
        },
        {
            "scope": "constant.regexp",
            "foreground": "#646695"
        },
        {
            "scope": "entity.name.tag",
            "foreground": "#569cd6"
        },
        {
            "scope": "entity.name.tag.css, entity.name.tag.less",
            "foreground": "#d7ba7d"
        },
        {
            "scope": "entity.other.attribute-name",
            "foreground": "#9cdcfe"
        },
        {
            "scope": "entity.other.attribute-name.class.css, source.css entity.other.attribute-name.class, entity.other.attribute-name.id.css, entity.other.attribute-name.parent-selector.css, entity.other.attribute-name.parent.less, source.css entity.other.attribute-name.pseudo-class, entity.other.attribute-name.pseudo-element.css, source.css.less entity.other.attribute-name.id, entity.other.attribute-name.scss",
            "foreground": "#d7ba7d"
        },
        {
            "scope": "invalid",
            "foreground": "#f44747"
        },
        {
            "scope": "markup.underline",
            "font_style": "underline"
        },
        {
            "scope": "markup.bold",
            "foreground": "#569cd6",
            "font_style": "bold"
        },
        {
            "scope": "markup.heading, markup.heading entity.name.section",
            "foreground": "#569cd6",
            "font_style": "bold"
        },
        {
            "scope": "markup.italic",
            "foreground": "#C586C0",
            "font_style": "italic"
        },
        {
            "scope": "markup.strikethrough",
            "font_style": "stippled_underline"
        },
        {
            "scope": "markup.inserted",
            "foreground": "#b5cea8"
        },
        {
            "scope": "markup.deleted",
            "foreground": "#ce9178"
        },
        {
            "scope": "markup.changed",
            "foreground": "#569cd6"
        },
        {
            "scope": "punctuation.definition.quote.begin.markdown",
            "foreground": "#6A9955"
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "foreground": "#6796e6"
        },
        {
            "scope": "markup.inline.raw, markup.raw.inline, markup.raw.block",
            "foreground": "#ce9178"
        },
        {
            "name": "brackets of XML/HTML tags",
            "scope": "punctuation.definition.tag",
            "foreground": "#808080"
        },
        {
            "scope": "meta.preprocessor, entity.name.function.preprocessor",
            "foreground": "#569cd6"
        },
        {
            "scope": "meta.preprocessor.string",
            "foreground": "#ce9178"
        },
        {
            "scope": "meta.preprocessor.numeric",
            "foreground": "#b5cea8"
        },
        {
            "scope": "meta.structure.dictionary.key.python",
            "foreground": "#9cdcfe"
        },
        {
            "scope": "meta.diff.header",
            "foreground": "#569cd6"
        },
        {
            "scope": "storage",
            "foreground": "#569cd6"
        },
        {
            "scope": "storage.type",
            "foreground": "#569cd6"
        },
        {
            "scope": "storage.modifier, keyword.operator.noexcept",
            "foreground": "#569cd6"
        },
        {
            "scope": "string, meta.embedded.assembly",
            "foreground": "#ce9178"
        },
        {
            "scope": "string.tag",
            "foreground": "#ce9178"
        },
        {
            "scope": "string.value",
            "foreground": "#ce9178"
        },
        {
            "scope": "string.regexp",
            "foreground": "#d16969"
        },
        {
            "name": "String interpolation",
            "scope": "punctuation.definition.template-expression.begin, punctuation.definition.template-expression.end, punctuation.section.embedded",
            "foreground": "#569cd6"
        },
        {
            "name": "Reset JavaScript string interpolation expression",
            "scope": "meta.template.expression",
            "foreground": "#d4d4d4"
        },
        {
            "scope": "support.type.vendored.property-name, support.type.property-name, source.css variable, source.coffee.embedded",
            "foreground": "#9cdcfe"
        },
        {
            "scope": "keyword",
            "foreground": "#569cd6"
        },
        {
            "scope": "keyword.control",
            "foreground": "#569cd6"
        },
        {
            "scope": "keyword.operator",
            "foreground": "#d4d4d4"
        },
        {
            "scope": "keyword.operator.new, keyword.operator.expression, keyword.operator.cast, keyword.operator.sizeof, keyword.operator.alignof, keyword.operator.typeid, keyword.operator.alignas, keyword.operator.instanceof, keyword.operator.logical.python, keyword.operator.wordlike",
            "foreground": "#569cd6"
        },
        {
            "scope": "keyword.other.unit",
            "foreground": "#b5cea8"
        },
        {
            "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
            "foreground": "#569cd6"
        },
        {
            "scope": "support.function.git-rebase",
            "foreground": "#9cdcfe"
        },
        {
            "scope": "constant.sha.git-rebase",
            "foreground": "#b5cea8"
        },
        {
            "name": "coloring of the Java import and package identifiers",
            "scope": "storage.modifier.import.java, variable.language.wildcard.java, storage.modifier.package.java",
            "foreground": "#d4d4d4"
        },
        {
            "name": "this.self",
            "scope": "variable.language",
            "foreground": "#569cd6"
        },
        {
            "name": "Function declarations",
            "scope": "entity.name.function, variable.function, meta.function-call entity.name.function, meta.function-call variable.function, support.function, support.function.builtin, support.constant.handlebars, source.powershell variable.other.member, entity.name.operator.custom-literal",
            "foreground": "#DCDCAA"
        },
        {
            "name": "Types declaration and references",
            "scope": "support.class, support.type, entity.name.type, entity.name.interface, entity.name.struct, entity.name.enum, entity.name.type.alias, entity.name.namespace, variable.other.namespace, entity.other.attribute, entity.name.scope-resolution, entity.name.class, storage.type.numeric.go, storage.type.byte.go, storage.type.boolean.go, storage.type.string.go, storage.type.uintptr.go, storage.type.error.go, storage.type.rune.go, storage.type.cs, storage.type.generic.cs, storage.type.modifier.cs, storage.type.variable.cs, storage.type.annotation.java, storage.type.generic.java, storage.type.java, storage.type.object.array.java, storage.type.primitive.array.java, storage.type.primitive.java, storage.type.token.java, storage.type.groovy, storage.type.annotation.groovy, storage.type.parameters.groovy, storage.type.generic.groovy, storage.type.object.array.groovy, storage.type.primitive.array.groovy, storage.type.primitive.groovy",
            "foreground": "#4EC9B0"
        },
        {
            "name": "Types declaration and references, TS grammar specific",
            "scope": "meta.type.cast.expr, meta.type.new.expr, support.constant.math, support.constant.dom, support.constant.json, entity.other.inherited-class, punctuation.separator.namespace.ruby",
            "foreground": "#4EC9B0"
        },
        {
            "name": "Control flow / Special keywords",
            "scope": "keyword.control, source.cpp keyword.operator.new, keyword.operator.delete, keyword.other.using, keyword.other.directive.using, keyword.other.operator, entity.name.operator",
            "foreground": "#C586C0"
        },
        {
            "name": "Variable and parameter name",
            "scope": "variable, variable.parameter, variable.other.member, variable.other.property, meta.mapping.key variable, meta.object-literal.key variable, meta.definition.variable.name, support.variable, entity.name.variable, constant.other.placeholder",
            "foreground": "#9CDCFE"
        },
        {
            "name": "Constants and enums",
            "scope": "variable.other.constant, constant.other.enum, constant.other.enummember, variable.other.enummember",
            "foreground": "#4FC1FF"
        },
        {
            "name": "Object keys, TS grammar specific",
            "scope": "meta.object-literal.key, meta.mapping.key, meta.mapping.key string, variable.other.property",
            "foreground": "#9CDCFE"
        },
        {
            "name": "CSS property value",
            "scope": "support.constant.property-value, support.constant.font-name, support.constant.media-type, support.constant.media, constant.other.color.rgb-value, constant.other.rgb-value, support.constant.color",
            "foreground": "#CE9178"
        },
        {
            "name": "Regular expression groups",
            "scope": "punctuation.definition.group.regexp, punctuation.definition.group.assertion.regexp, punctuation.definition.character-class.regexp, punctuation.character.set.begin.regexp, punctuation.character.set.end.regexp, keyword.operator.negation.regexp, support.other.parenthesis.regexp",
            "foreground": "#CE9178"
        },
        {
            "scope": "constant.character.character-class.regexp, constant.other.character-class.set.regexp, constant.other.character-class.regexp, constant.character.set.regexp",
            "foreground": "#d16969"
        },
        {
            "scope": "keyword.operator.or.regexp, keyword.control.anchor.regexp",
            "foreground": "#DCDCAA"
        },
        {
            "scope": "keyword.operator.quantifier.regexp",
            "foreground": "#d7ba7d"
        },
        {
            "scope": "constant.character, constant.other.option",
            "foreground": "#569cd6"
        },
        {
            "scope": "constant.character.escape",
            "foreground": "#d7ba7d"
        },
        {
            "scope": "entity.name.label, entity.name.label.reference",
            "foreground": "#C8C8C8"
        },
        {
            "name": "Markdown links and URLs",
            "scope": "markup.underline.link, markup.underline.link.image, string.other.link, meta.link.inline string, meta.link.reference string",
            "foreground": "#569cd6"
        },
        {
            "name": "Markdown list and quote markers",
            "scope": "punctuation.definition.list_item.markdown, markup.list.numbered.bullet.markdown, markup.list.unnumbered.bullet.markdown, punctuation.definition.blockquote.markdown, punctuation.definition.quote, punctuation.definition.heading.markdown",
            "foreground": "#569cd6"
        },
        {
            "name": "Markdown fenced code punctuation",
            "scope": "punctuation.definition.raw.code-fence, punctuation.definition.raw.begin.markdown, punctuation.definition.raw.end.markdown, punctuation.definition.fenced.markdown, meta.code-fence.definition.markdown-gfm",
            "foreground": "#6A9955"
        },
        {
            "name": "Markdown table punctuation",
            "scope": "punctuation.separator.table-cell.markdown, punctuation.section.table-header.markdown, punctuation.definition.table-cell-alignment.markdown",
            "foreground": "#d4d4d4"
        },
        {
            "name": "Markdown block quotes",
            "scope": "markup.quote, markup.quote punctuation",
            "foreground": "#6A9955"
        },
        {
            "name": "LaTeX commands",
            "scope": "support.function.general.latex, support.function.internal.latex, support.function.general.tex, support.function.internal.tex, entity.name.newcommand.latex",
            "foreground": "#DCDCAA"
        },
        {
            "name": "LaTeX environments and sections",
            "scope": "entity.name.environment.latex, entity.name.section.latex, entity.name.section.tex, support.class.latex, variable.parameter.function.latex",
            "foreground": "#4EC9B0"
        },
        {
            "name": "LaTeX references and citations",
            "scope": "constant.other.reference.latex, constant.other.citation.latex, variable.other.reference.latex, variable.other.citation.latex, entity.name.label.latex",
            "foreground": "#4FC1FF"
        },
        {
            "name": "LaTeX parameters",
            "scope": "variable.parameter.latex, variable.parameter.tex, variable.other.macro.tex",
            "foreground": "#9CDCFE"
        },
        {
            "name": "LaTeX math operators",
            "scope": "keyword.operator.math.latex, keyword.operator.math.tex, support.function.math.latex, support.function.math.tex",
            "foreground": "#d4d4d4"
        },
        {
            "name": "LaTeX group punctuation",
            "scope": "punctuation.definition.group.latex, punctuation.definition.group.tex, punctuation.definition.brackets.latex, punctuation.definition.brackets.tex",
            "foreground": "#d4d4d4"
        },
        {
            "name": "LSP semantic highlighting activation",
            "scope": "meta.semantic-token",
            "background": "#00000101"
        },
        {
            "name": "Semantic functions",
            "scope": "meta.semantic-token.function, meta.semantic-token.method, meta.semantic-token.event",
            "foreground": "#DCDCAA"
        },
        {
            "name": "Semantic macros",
            "scope": "meta.semantic-token.macro",
            "foreground": "#569cd6"
        },
        {
            "name": "Semantic types",
            "scope": "meta.semantic-token.type, meta.semantic-token.class, meta.semantic-token.interface, meta.semantic-token.struct, meta.semantic-token.enum, meta.semantic-token.namespace, meta.semantic-token.typeparameter",
            "foreground": "#4EC9B0"
        },
        {
            "name": "Semantic variables",
            "scope": "meta.semantic-token.variable, meta.semantic-token.parameter, meta.semantic-token.property",
            "foreground": "#9CDCFE"
        },
        {
            "name": "Semantic enum members",
            "scope": "meta.semantic-token.enummember",
            "foreground": "#4FC1FF"
        },
        {
            "name": "Semantic keywords",
            "scope": "meta.semantic-token.keyword, meta.semantic-token.modifier",
            "foreground": "#569cd6"
        },
        {
            "name": "Semantic comments",
            "scope": "meta.semantic-token.comment",
            "foreground": "#6A9955"
        },
        {
            "name": "Semantic strings",
            "scope": "meta.semantic-token.string",
            "foreground": "#ce9178"
        },
        {
            "name": "Semantic numbers",
            "scope": "meta.semantic-token.number",
            "foreground": "#b5cea8"
        },
        {
            "name": "Semantic regular expressions",
            "scope": "meta.semantic-token.regexp",
            "foreground": "#d16969"
        },
        {
            "name": "Semantic operators",
            "scope": "meta.semantic-token.operator",
            "foreground": "#d4d4d4"
        },
        {
            "name": "Semantic decorators",
            "scope": "meta.semantic-token.decorator",
            "foreground": "#DCDCAA"
        },
        {
            "name": "Semantic labels",
            "scope": "meta.semantic-token.label",
            "foreground": "#C8C8C8"
        },
        {
            "name": "Semantic readonly values",
            "scope": "meta.semantic-token.variable.readonly, meta.semantic-token.parameter.readonly, meta.semantic-token.property.readonly",
            "foreground": "#4FC1FF"
        },
        {
            "name": "VS Code semantic token: newOperator",
            "scope": "meta.semantic-token.newoperator",
            "foreground": "#C586C0"
        },
        {
            "name": "VS Code semantic token: stringLiteral",
            "scope": "meta.semantic-token.stringliteral",
            "foreground": "#ce9178"
        },
        {
            "name": "VS Code semantic token: customLiteral",
            "scope": "meta.semantic-token.customliteral",
            "foreground": "#DCDCAA"
        },
        {
            "name": "VS Code semantic token: numberLiteral",
            "scope": "meta.semantic-token.numberliteral",
            "foreground": "#b5cea8"
        }
    ]
}
