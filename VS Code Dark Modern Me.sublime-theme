{
    "extends": "Default Dark.sublime-theme",
    "variables": {
        "ui_bg": "#181818",
        "text_fg": "#CCCCCC",
        "link_fg": "#4DAAFC",
        "button_bg": "#313131",
        "sidebar_bg": "#181818",
        "sidebar_row_selected": "#04395E",
        "sidebar_heading": "#CCCCCC",
        "sidebar_label": "#CCCCCC",
        "sidebar_label_selected": "#FFFFFF",
        "sidebar_label_ignored": "#868686",
        "panel_bg": "#181818",
        "overlay_bg": "#202020",
        "status_bar_bg": "#181818",
        "progress_bar_fg": "#0078D4",
        "dialog_button_bg": "#0078D4",
        "icon_button_highlight": "#2B2B2B",
        "tabset_dark_bg": "#181818",
        "tabset_medium_dark_bg": "#181818",
        "tabset_medium_bg": "#181818",
        "tabset_light_bg": "#181818",
        "quick_panel_label_color": "#CCCCCC",
        "quick_panel_path_label_color": "#9D9D9D",
        "quick_panel_matched_label_color": "#FFFFFF",
        "quick_panel_selected_row_bg": "#04395E",
        "quick_panel_selected_label_color": "#FFFFFF",
        "scroll_bar_bg": "#181818",
        "scroll_bar_puck_bg": "#5A5A5A",
        "file_tab_close_dark_tint": "#9D9D9D",
        "file_tab_close_dark_modified_tint": "#9D9D9D"
    },
    "rules": [
        { "class": "title_bar", "style": "dark" },
        { "class": "tabset_control", "layer0.tint": "#181818" },
        {
            "class": "tabset_control",
            "settings": {"file_tab_style": "square"},
            "tab_overlap": 0,
            "spacing": 0,
            "tab_width": 0,
            "tab_min_width": 0,
            "content_margin": [0, 1, 0, 0]
        },
        {
            "class": "tab_control",
            "settings": {"file_tab_style": "square"},
            "attributes": ["!selected"],
            "layer1.tint": "#181818"
        },
        {
            "class": "tab_control",
            "settings": {"file_tab_style": "square"},
            "attributes": ["selected"],
            "layer1.tint": "#1F1F1F",
            "layer2.texture": "tab_square_highlight_thin.png",
            "layer2.tint": "#0078D4",
            "layer2.opacity": 1.0
        },
        {
            "class": "tab_label",
            "parents": [{"class": "tab_control", "attributes": ["!selected"]}],
            "fg": "#9D9D9D"
        },
        {
            "class": "tab_label",
            "parents": [{"class": "tab_control", "attributes": ["selected"]}],
            "fg": "#FFFFFF"
        },
        {
            "class": "tab_close_button",
            "parents": [{"class": "tab_control", "attributes": ["selected"]}],
            "layer0.tint": "#FFFFFF"
        },
        {
            "class": "tab_close_button",
            "parents": [{"class": "tab_control", "attributes": ["!selected"]}],
            "layer0.tint": "#9D9D9D"
        },
        {
            "class": "tab_close_button",
            "attributes": ["hover"],
            "layer0.tint": "#FFFFFF"
        },
        { "class": "sidebar_container", "layer0.tint": "#181818" },
        {
            "class": "icon_file_type",
            "layer0.tint": "#CCCCCC",
            "layer0.opacity": 0.5,
            "content_margin": [9, 8]
        },
        { "class": "panel_control", "layer0.tint": "#181818" },
        {
            "class": "quick_panel",
            "layer0.border_color": "#5A5A5A",
            "layer0.border_size": 1
        },
        { "class": "status_bar", "layer0.tint": "#181818" },
        { "class": "text_line_control", "layer0.tint": "#313131" },
        {
            "class": "show_tabs_dropdown_button",
            "layer0.opacity": 0,
            "content_margin": 0
        }
    ]
}
